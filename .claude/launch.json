{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "db",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "db", "-w", "@pricepilot/api"],
      "port": 27017,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@pricepilot/api"],
      "port": 4000,
      "autoPort": false
    }
  ]
}
