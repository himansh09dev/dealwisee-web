# Copy to api/.env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# Local: `npm run db` starts MongoDB on 27017.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pricepilot?retryWrites=true&w=majority
#   - include the /pricepilot database name (otherwise Atlas uses "test")
#   - URL-encode special characters in the password
#   - allow your IP under Atlas → Network Access
MONGODB_URI=mongodb://127.0.0.1:27017/pricepilot

# Browser origin(s) allowed by CORS and the CSRF origin check (comma-separated).
FRONTEND_ORIGIN=http://localhost:3000

SESSION_TTL_DAYS=7
# Proxy hops to trust for client IPs (rate limiting). "loopback" for local dev;
# set to 1 behind a single load balancer.
TRUST_PROXY=loopback
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
SCRYPT_LOG_N=17
LOG_LEVEL=info

# Seed accounts (used only by `npm run seed`). Choose your own values;
# passwords need 10+ characters with a letter and a number.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me-admin-1
SEED_USER_EMAIL=shopper@example.test
SEED_USER_PASSWORD=change-me-user-1
