{
  "name": "pricepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db": "npm run db -w @pricepilot/api",
    "seed": "npm run seed -w @pricepilot/api",
    "dev:api": "npm run dev -w @pricepilot/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run typecheck -w @pricepilot/contracts && npm run typecheck -w @pricepilot/api && npm test -w @pricepilot/api"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@pricepilot/contracts": "0.1.0",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "packages/*"
  ]
}
